---
import BaseLayout from "../layouts/BaseLayout.astro";

// Bloc 1 du BTS SIO : Support et mise à disposition de services informatiques (épreuve E5)
const competences = [
  { code: "B1.1", label: "Gérer le patrimoine informatique" },
  { code: "B1.2", label: "Répondre aux incidents et aux demandes d'assistance et d'évolution" },
  { code: "B1.3", label: "Développer la présence en ligne de l'organisation" },
  { code: "B1.4", label: "Travailler en mode projet" },
  { code: "B1.5", label: "Mettre à disposition des utilisateurs un service informatique" },
  { code: "B1.6", label: "Organiser son développement professionnel" },
];

// Compétences complémentaires de l'option SISR (blocs 2 et 3)
const complementaires = [
  { code: "B2.1", label: "Concevoir une solution d'infrastructure réseau" },
  { code: "B2.2", label: "Installer, tester et déployer une solution d'infrastructure réseau" },
  { code: "B2.3", label: "Exploiter, dépanner et superviser une solution d'infrastructure réseau" },
  { code: "B3.4", label: "Garantir la disponibilité, l'intégrité et la confidentialité des services informatiques et des données" },
  { code: "B3.5", label: "Assurer la cybersécurité d'une infrastructure réseau, d'un système, d'un service" },
];

// Pour ajouter une réalisation : copier un bloc, puis renseigner la période, les productions et les codes de compétences
const realisations = [
  {
    titre: "Hotspot Wi-Fi MikroTik",
    contexte: "Projet personnel",
    periode: "2026",
    lien: "/projects#hotspot",
    productions: ["Fiche de réalisation", "Outil Python de génération de tickets"],
    competences: ["B1.1", "B1.5"],
    complementaires: ["B2.1", "B2.2", "B2.3"],
  },
  {
    titre: "Active Directory, DHCP et DNS",
    contexte: "Projet de formation, École polytechnique de Lomé",
    periode: "2024 – 2026",
    lien: "/projects#windows-server",
    productions: ["Fiche de réalisation"],
    competences: ["B1.1", "B1.5"],
    complementaires: ["B2.1", "B2.2", "B3.5"],
  },
  {
    titre: "NAS OpenMediaVault",
    contexte: "Projet de formation, École polytechnique de Lomé",
    periode: "2024 – 2026",
    lien: "/projects#nas",
    productions: ["Fiche de réalisation"],
    competences: ["B1.2", "B1.5"],
    complementaires: ["B2.2"],
  },
  {
    titre: "Authentification RFID",
    contexte: "Cours de gestion de projet, École polytechnique de Lomé",
    periode: "2024 – 2026",
    lien: "/projects#rfid",
    productions: ["Fiche de réalisation"],
    competences: ["B1.4"],
    complementaires: ["B3.5"],
  },
  {
    titre: "Serveur web Apache sous Debian",
    contexte: "Projet de formation",
    periode: "2024 – 2026",
    lien: "/projects#serveur-web",
    productions: ["Fiche de réalisation"],
    competences: ["B1.1"],
    complementaires: ["B2.2", "B3.5"],
  },
  {
    titre: "Bases de données PostgreSQL et Oracle",
    contexte: "Projet de formation",
    periode: "2024 – 2026",
    lien: "/projects#bases-de-donnees",
    productions: ["Fiche de réalisation"],
    competences: ["B1.1", "B1.2"],
    complementaires: ["B2.3", "B3.4"],
  },
  {
    titre: "Portfolio et veille technologique",
    contexte: "Projet personnel",
    periode: "Novembre 2026 – en cours",
    lien: "/",
    productions: ["Ce site (portfolio)", "Veille technologique publiée sur le site"],
    competences: ["B1.3", "B1.6"],
    complementaires: [],
  },
];
---

<BaseLayout title="Synthèse" sideBarActiveItemID="synthese">
  <div class="pb-6 mt-5">
    <div class="text-5xl font-bold">Tableau de synthèse</div>
    <p class="text-lg py-3">
      Récapitulatif de mes réalisations professionnelles, avec les compétences du bloc « Support et mise à disposition de
      services informatiques » qu'elles mobilisent.
    </p>
  </div>

  <div class="overflow-x-auto mb-10">
    <table class="table table-zebra">
      <thead>
        <tr>
          <th>Réalisation</th>
          <th>Période</th>
          <th>Productions et documents associés</th>
          {competences.map((c) => <th class="text-center" title={c.label}>{c.code}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          realisations.map((r) => (
            <tr>
              <td>
                <a href={r.lien} class="font-bold underline">{r.titre}</a>
                <div class="text-sm opacity-70">{r.contexte}</div>
              </td>
              <td class="whitespace-nowrap">{r.periode}</td>
              <td>
                <ul class="list-disc ml-4">
                  {r.productions.map((prod) => <li>{prod}</li>)}
                </ul>
              </td>
              {competences.map((c) => (
                <td class="text-center text-xl">{r.competences.includes(c.code) ? "●" : ""}</td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="text-2xl font-bold mb-3">Légende</div>
  <ul class="grid gap-2 mb-10">
    {
      competences.map((c) => (
        <li>
          <b>{c.code}</b> : {c.label}
        </li>
      ))
    }
  </ul>

  <div class="text-3xl font-bold mb-3">Compétences complémentaires de l'option SISR</div>
  <p class="mb-4 opacity-80">
    Les mêmes réalisations mobilisent aussi des compétences d'administration des systèmes et des réseaux (bloc 2) et de
    cybersécurité (bloc 3).
  </p>

  <div class="overflow-x-auto mb-6">
    <table class="table table-zebra">
      <thead>
        <tr>
          <th>Réalisation</th>
          {complementaires.map((c) => <th class="text-center" title={c.label}>{c.code}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          realisations
            .filter((r) => r.complementaires.length > 0)
            .map((r) => (
              <tr>
                <td>
                  <a href={r.lien} class="font-bold underline">{r.titre}</a>
                </td>
                {complementaires.map((c) => (
                  <td class="text-center text-xl">{r.complementaires.includes(c.code) ? "●" : ""}</td>
                ))}
              </tr>
            ))
        }
      </tbody>
    </table>
  </div>

  <ul class="grid gap-2 mb-10">
    {
      complementaires.map((c) => (
        <li>
          <b>{c.code}</b> : {c.label}
        </li>
      ))
    }
  </ul>
  <!-- À FAIRE : joindre aussi le modèle officiel de tableau de synthèse (fichier Excel de la circulaire nationale) renseigné avec les mêmes informations. À COMPLÉTER : périodes exactes, productions et documents réels de chaque réalisation (schémas, rapports, scripts). Vérifier les intitulés avec le référentiel officiel. -->
</BaseLayout>