---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";

// Articles de veille générés par scripts/veille.py (GitHub Actions) dans veille/index.json
const files = import.meta.glob("../../veille/index.json", { eager: true });
const raw = Object.values(files)[0];
const entries = (raw && (raw.default ?? raw)) || [];
const latest = entries
  .flatMap((e) => e.articles.map((a) => ({ ...a, date: e.date })))
  .sort((a, b) => (b.published || b.date).localeCompare(a.published || a.date))
  .slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Bonjour 👋</div>
    <div class="text-5xl font-bold">Je suis Régis EKLO</div>
    <div class="text-3xl py-3 font-bold">Étudiant en BTS SIO, option SISR (2<sup>e</sup> année)</div>
    <div class="py-2">
      <p class="text-lg">
        Passionné par les <b>réseaux</b> et les <b>systèmes</b>, je me forme à l'administration
        d'infrastructures : labs Cisco/GNS3, MikroTik, Windows Server et virtualisation.
        Ce site regroupe mon <b>parcours</b>, mes <b>réalisations</b>, ma <b>veille technologique</b> et mon
        <b>tableau de synthèse</b>.
      </p>
    </div>
    <div class="mt-8">
      <a class="btn" href="/projects"> Voir mes réalisations</a>
      <a href="/veille" class="btn btn-outline ml-5"> Ma veille technologique </a>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-2">Mes dernières réalisations {"</>"}</div>
  </div>

  <HorizontalCard
    title="Hotspot Wi-Fi MikroTik"
    img="/post_img.webp"
    desc="Hotspot centralisé sur routeur MikroTik : roaming entre bornes, profils d'accès par durée et génération de tickets."
    url="/projects#hotspot"
    target="_self"
    badge="RÉSEAU"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Active Directory, DHCP et DNS"
    img="/post_img.webp"
    desc="Mise en place d'un domaine Active Directory, d'un serveur DHCP et du DNS sous Windows Server, sur un serveur physique."
    url="/projects#windows-server"
    target="_self"
    badge="SYSTÈME"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="NAS avec OpenMediaVault"
    img="/post_img.webp"
    desc="Déploiement d'un serveur de stockage en réseau avec OpenMediaVault sur Raspberry Pi."
    url="/projects#nas"
    target="_self"
    badge="STOCKAGE"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Authentification RFID"
    img="/post_img.webp"
    desc="Système d'authentification par badge RFID sur Arduino, avec suivi des présences et absences en base de données."
    url="/projects#rfid"
    target="_self"
    badge="SÉCURITÉ"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Serveur web Apache sous Debian"
    img="/post_img.webp"
    desc="Installation et configuration d'un serveur web Apache sous Debian, avec création d'utilisateurs et contrôle des droits."
    url="/projects#serveur-web"
    target="_self"
    badge="SYSTÈME"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Bases de données : PostgreSQL et Oracle"
    img="/post_img.webp"
    desc="SQL avec PostgreSQL, sauvegarde et restauration avec Oracle (RMAN), dont une restauration après panne simulée."
    url="/projects#bases-de-donnees"
    target="_self"
    badge="DONNÉES"
  />

  <div>
    <div class="text-3xl w-full font-bold mb-5 mt-10">Dernières publications de la veille</div>
  </div>

  {
    latest.map((a) => (
      <>
        <HorizontalCard
          title={a.titre}
          img="/post_img.webp"
          desc={a.resume}
          url={a.link}
          target="_blank"
          badge={a.source}
        />
        <div class="divider my-0" />
      </>
    ))
  }
  {latest.length === 0 && <p class="opacity-70">La première veille sera publiée prochainement.</p>}
  <div class="mt-4">
    <a href="/veille" class="btn btn-outline">Voir toute la veille</a>
  </div>
</BaseLayout>